# APP_URL: Base URL where the web/PWA server is hosted (used for OAuth callback resolution)
APP_URL="http://localhost:3000"

# CLIENT_ID: Intervals.icu OAuth 2.0 Public Client ID (PKCE S256)
CLIENT_ID="1781"

# OAUTH_REDIRECT_URI: Optional explicit OAuth redirect URI override
OAUTH_REDIRECT_URI=""

# CLIENT_SECRET: Leave empty for Public Client + PKCE (S256)
CLIENT_SECRET=""

# VITE_INTERVALS_API_KEY: Optional placeholder for local development testing
VITE_INTERVALS_API_KEY="your_key_here"
